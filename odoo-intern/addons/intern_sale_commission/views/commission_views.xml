<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quy tắc hoa hồng -->
    <record id="view_commission_rule_list" model="ir.ui.view">
        <field name="name">sale.commission.rule.list</field>
        <field name="model">sale.commission.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="percent"/>
                <field name="basis"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">sale.commission.rule</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Hoa hồng đã sinh -->
    <record id="view_commission_list" model="ir.ui.view">
        <field name="name">sale.commission.list</field>
        <field name="model">sale.commission</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="user_id"/>
                <field name="move_id"/>
                <field name="basis"/>
                <field name="base_amount"/>
                <field name="percent"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_commission_pivot" model="ir.ui.view">
        <field name="name">sale.commission.pivot</field>
        <field name="model">sale.commission</field>
        <field name="arch" type="xml">
            <pivot string="Commissions">
                <field name="date" interval="month" type="row"/>
                <field name="user_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_commission_graph" model="ir.ui.view">
        <field name="name">sale.commission.graph</field>
        <field name="model">sale.commission</field>
        <field name="arch" type="xml">
            <graph string="Commissions" type="bar">
                <field name="date" interval="month"/>
                <field name="user_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_commission_search" model="ir.ui.view">
        <field name="name">sale.commission.search</field>
        <field name="model">sale.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="move_id"/>
                <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>
    <record id="action_commission_report" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sale.commission</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <menuitem id="menu_commission_rule" name="Commission Rules" parent="sale.menu_sale_config"
              action="action_commission_rule" sequence="40" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_commission_report" name="Commissions" parent="sale.menu_sale_report"
              action="action_commission_report" sequence="40"/>
</odoo>
