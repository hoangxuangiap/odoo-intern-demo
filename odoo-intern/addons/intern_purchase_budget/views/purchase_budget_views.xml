<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_budget_list" model="ir.ui.view">
        <field name="name">purchase.budget.list</field>
        <field name="model">purchase.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="category_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="amount" sum="Total"/>
                <field name="spent_amount" sum="Total"/>
                <field name="remaining_amount" sum="Total"
                       decoration-danger="remaining_amount &lt; 0"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_budget_form" model="ir.ui.view">
        <field name="name">purchase.budget.form</field>
        <field name="model">purchase.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="spent_amount"/>
                            <field name="remaining_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_budget" model="ir.actions.act_window">
        <field name="name">Purchase Budgets</field>
        <field name="res_model">purchase.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_budget"
              name="Purchase Budgets"
              parent="purchase.menu_purchase_config"
              action="action_purchase_budget"
              sequence="35"/>
</odoo>
