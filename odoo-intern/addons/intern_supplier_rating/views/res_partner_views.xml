<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_supplier_rating" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.rating</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_supplier_ratings" icon="fa-star">
                    <div class="o_stat_info">
                        <field name="rating_count" class="o_stat_value"/>
                        <span class="o_stat_text">Ratings (avg <field name="rating_avg" class="oe_inline"/>)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
