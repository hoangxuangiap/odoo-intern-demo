<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_rating_list" model="ir.ui.view">
        <field name="name">supplier.rating.list</field>
        <field name="model">supplier.rating</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="quality_score"/>
                <field name="delivery_score"/>
                <field name="price_score"/>
                <field name="average_score"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_rating_form" model="ir.ui.view">
        <field name="name">supplier.rating.form</field>
        <field name="model">supplier.rating</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="purchase_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="quality_score"/>
                            <field name="delivery_score"/>
                            <field name="price_score"/>
                            <field name="average_score"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Comments about this vendor..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_supplier_rating_search" model="ir.ui.view">
        <field name="name">supplier.rating.search</field>
        <field name="model">supplier.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <group>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supplier_rating" model="ir.actions.act_window">
        <field name="name">Supplier Ratings</field>
        <field name="res_model">supplier.rating</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <menuitem id="menu_supplier_rating"
              name="Supplier Ratings"
              parent="purchase.menu_purchase_config"
              action="action_supplier_rating"
              sequence="30"/>
</odoo>
