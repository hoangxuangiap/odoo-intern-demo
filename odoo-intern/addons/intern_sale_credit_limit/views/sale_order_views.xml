<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_credit_limit" model="ir.ui.view">
        <field name="name">sale.order.form.intern.credit.limit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve_credit" type="object" string="Approve Credit"
                        class="btn-primary" invisible="state != 'waiting_approval'"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_refuse_credit" type="object" string="Refuse Credit"
                        invisible="state != 'waiting_approval'"
                        groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0" role="alert" invisible="not credit_warning">
                    <field name="credit_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
