<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.intern.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- 1. Sửa nút "Approve Order" chuẩn: chỉ hiện đúng group + đủ cấp -->
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="string">Approve</attribute>
                <attribute name="invisible">state != 'to approve' or not can_approve</attribute>
                <attribute name="groups">intern_purchase_approval.group_purchase_dept_head,intern_purchase_approval.group_purchase_director</attribute>
            </xpath>

            <!-- 2. Thêm nút Từ chối ngay sau nút Duyệt -->
            <xpath expr="//button[@name='button_approve']" position="after">
                <button name="action_open_reject_wizard" type="object" string="Reject"
                        invisible="state != 'to approve' or not can_approve"
                        groups="intern_purchase_approval.group_purchase_dept_head,intern_purchase_approval.group_purchase_director"/>
            </xpath>

            <!-- 3. Banner báo cấp duyệt cần thiết + field can_approve để dùng trong invisible -->
            <xpath expr="//header" position="after">
                <field name="can_approve" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state not in ('draft', 'sent', 'to approve') or approval_level == 'none'">
                    Approval required: <field name="approval_level" readonly="1" class="oe_inline fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Menu "Orders to Approve" cho người duyệt -->
    <record id="action_purchase_order_to_approve" model="ir.actions.act_window">
        <field name="name">Orders to Approve</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'to approve')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_purchase_order_to_approve"
              name="Orders to Approve"
              parent="purchase.menu_procurement_management"
              action="action_purchase_order_to_approve"
              sequence="5"
              groups="group_purchase_dept_head,group_purchase_director"/>
</odoo>
