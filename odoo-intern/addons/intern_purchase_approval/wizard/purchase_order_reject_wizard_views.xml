<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.reject.wizard.form</field>
        <field name="model">purchase.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <group>
                    <field name="order_id" readonly="1" force_save="1"/>
                    <field name="reason" placeholder="Why is this order rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Rejection"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
