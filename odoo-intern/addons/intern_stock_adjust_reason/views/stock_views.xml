<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thêm cột "Reason" vào màn hình Physical Inventory -->
    <record id="view_stock_quant_tree_inventory_reason" model="ir.ui.view">
        <field name="name">stock.quant.inventory.reason</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity']" position="after">
                <field name="inventory_reason_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Danh mục lý do -->
    <record id="view_stock_inventory_reason_list" model="ir.ui.view">
        <field name="name">stock.inventory.reason.list</field>
        <field name="model">stock.inventory.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="active" column_invisible="1"/></list>
        </field>
    </record>
    <record id="action_stock_inventory_reason" model="ir.actions.act_window">
        <field name="name">Adjustment Reasons</field>
        <field name="res_model">stock.inventory.reason</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Báo cáo thống kê theo lý do (trên stock.move) -->
    <record id="view_stock_move_reason_pivot" model="ir.ui.view">
        <field name="name">stock.move.reason.pivot</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Adjustments by Reason">
                <field name="reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_stock_move_reason_graph" model="ir.ui.view">
        <field name="name">stock.move.reason.graph</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <graph string="Adjustments by Reason" type="bar">
                <field name="reason_id"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_stock_move_reason_list" model="ir.ui.view">
        <field name="name">stock.move.reason.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="reason_id"/>
            </list>
        </field>
    </record>
    <record id="action_stock_move_by_reason" model="ir.actions.act_window">
        <field name="name">Adjustments by Reason</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('reason_id', '!=', False)]</field>
    </record>

    <menuitem id="menu_stock_adjust_reason_report" name="Adjustments by Reason"
              parent="stock.menu_warehouse_report" action="action_stock_move_by_reason" sequence="95"/>
    <menuitem id="menu_stock_adjust_reason_config" name="Adjustment Reasons"
              parent="stock.menu_stock_config_settings" action="action_stock_inventory_reason" sequence="95"
              groups="stock.group_stock_manager"/>
</odoo>
