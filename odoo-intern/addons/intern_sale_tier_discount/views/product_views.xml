<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_tier_discount" model="ir.ui.view">
        <field name="name">product.template.form.tier.discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tier Discount" name="tier_discount">
                    <field name="discount_tier_ids">
                        <list editable="bottom">
                            <field name="min_qty"/>
                            <field name="discount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
